{
  // Витрина devbrain.studio. Worker + статические ассеты.
  //
  // `worker.js` лежит ВНЕ `public/`: файл внутри папки ассетов раздавался бы
  // наружу как обычная статика, и серверный код там оказаться не должен.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devbrain-studio-site",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",

    // Без этого статика отдаётся ДО запуска скрипта: запрос `/` совпадает с
    // `public/index.html` и уходит напрямую, а роутер не вызывается вообще —
    // и любой поддомен молча показывает витрину вместо своего продукта.
    // Разводить по хосту может только скрипт, поэтому он идёт первым.
    "run_worker_first": true
  }
}
